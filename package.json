    "@fontsource/rajdhani": "5.3.0",
    "@slidev/cli": "53.0.0",
    "@slidev/parser": "53.0.0",
    "@slidev/types": "53.0.0",
    "katex": "0.18.10",
    "pdf-lib": "1.17.1",
    "playwright-chromium": "1.56.1"
  }
