+svg.tr-fig text { font-variant-numeric: tabular-nums; }
+figure.tr-figure > figcaption { max-width: 46em; margin: 0.7em auto 0; text-align: center; }
+figure.tr-figure > figcaption strong { color: var(--tr-ink); }
