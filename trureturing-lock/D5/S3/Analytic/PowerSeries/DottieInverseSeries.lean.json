      "line": 545,
      "signature": "theorem rational_inverse_endpoint : ∃ θ : ℝ, 0 < θ ∧ θ < 1 ∧ Real.cos θ = θ ∧ (∀ t : ℝ, 0 < t → Real.cos t = t → t = θ) ∧ Summable (fun n : ℕ => |((PowerSeries.coeff n inverse : ℚ) : ℝ)| * Real.pi ^ n) ∧ HasSum (fun n : ℕ => ((PowerSeries.coeff n inverse : ℚ) : ℝ) * Real.pi ^ n) θ",
