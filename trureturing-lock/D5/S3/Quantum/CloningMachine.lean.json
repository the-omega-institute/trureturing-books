    "D5/S3/Quantum/CloningMachine.machineReducedState": {
      "module": "D5/S3/Quantum/CloningMachine",
      "name": "D5.S3.Quantum.CloningMachine.machineReducedState",
      "kind": "def",
      "statement_id": "sha256:7e149ec412c74b629d34b514da1570cabdb3bb6ad6271334cffc244e5ea4b1a4",
      "line": 29,
      "signature": "noncomputable def machineReducedState (psi : QubitState) : QubitMatrix",
      "commit": "8a9135753f8e966382379c101b3934b577c07b4c"
    },
    "D5/S3/Quantum/CloningMachine.machine_entropy_closed_form": {
      "module": "D5/S3/Quantum/CloningMachine",
      "name": "D5.S3.Quantum.CloningMachine.machine_entropy_closed_form",
      "kind": "theorem",
      "statement_id": "sha256:7e149ec412c74b629d34b514da1570cabdb3bb6ad6271334cffc244e5ea4b1a4",
      "line": 140,
      "signature": "theorem machine_entropy_closed_form : machineEntropy = Real.logb 2 3 - 2 / 3",
      "commit": "8a9135753f8e966382379c101b3934b577c07b4c"
    },
    "D5/S3/Quantum/CloningMachine.machine_reduced_det": {
      "module": "D5/S3/Quantum/CloningMachine",
      "name": "D5.S3.Quantum.CloningMachine.machine_reduced_det",
      "kind": "theorem",
      "statement_id": "sha256:7e149ec412c74b629d34b514da1570cabdb3bb6ad6271334cffc244e5ea4b1a4",
      "line": 74,
      "signature": "theorem machine_reduced_det (psi : QubitState) (hUnit : star psi ⬝ᵥ psi = 1) : Matrix.det (machineReducedState psi) = (2 / 9 : Complex)",
      "commit": "8a9135753f8e966382379c101b3934b577c07b4c"
    },
    "D5/S3/Quantum/CloningMachine.machine_reduced_is_density": {
      "module": "D5/S3/Quantum/CloningMachine",
      "name": "D5.S3.Quantum.CloningMachine.machine_reduced_is_density",
      "kind": "theorem",
      "statement_id": "sha256:7e149ec412c74b629d34b514da1570cabdb3bb6ad6271334cffc244e5ea4b1a4",
      "line": 68,
      "signature": "theorem machine_reduced_is_density (psi : QubitState) (hUnit : star psi ⬝ᵥ psi = 1) : (machineReducedState psi).PosSemidef ∧ Matrix.trace (machineReducedState psi) = 1",
      "commit": "8a9135753f8e966382379c101b3934b577c07b4c"
    },
    "D5/S3/Quantum/CloningMachine.machine_reduced_spectrum": {
      "module": "D5/S3/Quantum/CloningMachine",
      "name": "D5.S3.Quantum.CloningMachine.machine_reduced_spectrum",
      "kind": "theorem",
      "statement_id": "sha256:7e149ec412c74b629d34b514da1570cabdb3bb6ad6271334cffc244e5ea4b1a4",
      "line": 125,
      "signature": "theorem machine_reduced_spectrum (psi : QubitState) (hUnit : star psi ⬝ᵥ psi = 1) : spectrum Complex (machineReducedState psi) = {(1 / 3 : Complex), (2 / 3 : Complex)}",
      "commit": "8a9135753f8e966382379c101b3934b577c07b4c"
    },
    "D5/S3/Quantum/CloningMachine.orthogonalQubit": {
      "module": "D5/S3/Quantum/CloningMachine",
      "name": "D5.S3.Quantum.CloningMachine.orthogonalQubit",
      "kind": "def",
      "statement_id": "sha256:7e149ec412c74b629d34b514da1570cabdb3bb6ad6271334cffc244e5ea4b1a4",
      "line": 19,
      "signature": "def orthogonalQubit (psi : QubitState) : QubitState",
      "commit": "8a9135753f8e966382379c101b3934b577c07b4c"
    },
    "D5/S3/Quantum/CloningMachine.orthogonal_qubit_inner": {
      "module": "D5/S3/Quantum/CloningMachine",
      "name": "D5.S3.Quantum.CloningMachine.orthogonal_qubit_inner",
      "kind": "theorem",
      "statement_id": "sha256:7e149ec412c74b629d34b514da1570cabdb3bb6ad6271334cffc244e5ea4b1a4",
      "line": 23,
      "signature": "theorem orthogonal_qubit_inner (psi : QubitState) : star psi ⬝ᵥ orthogonalQubit psi = 0",
      "commit": "8a9135753f8e966382379c101b3934b577c07b4c"
    }
  }
